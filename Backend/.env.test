# Environment untuk testing (CI & local test)
# File ini AMAN di-commit karena tidak ada kredensial production

NODE_ENV=test

# DB di CI (GitHub Actions PostgreSQL service)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ysq_test

# JWT (CI akan di-override oleh secrets.JWT_SECRET)
JWT_SECRET=ysq-secret-test

# Port app (tidak dipakai saat test, tapi perlu ada)
PORT=8000
BASE_URL=http://localhost:8000
